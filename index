<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Simulado ANBIMA - 90 Questões</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">

    <style>
        body { font-family: 'Inter', sans-serif; }
        
        /* Smooth scrolling */
        html { scroll-behavior: smooth; }

        /* Custom Scrollbar */
        ::-webkit-scrollbar { width: 8px; }
        ::-webkit-scrollbar-track { background: #f1f5f9; }
        ::-webkit-scrollbar-thumb { background-color: #cbd5e1; border-radius: 20px; }
        ::-webkit-scrollbar-thumb:hover { background-color: #94a3b8; }

        /* Animation for feedback */
        .fade-in-up { animation: fadeInUp 0.4s ease-out forwards; }
        @keyframes fadeInUp {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: translateY(0); }
        }
    </style>
</head>
<body class="bg-gray-50 text-slate-800">

    <!-- Top Bar Fixa (Progresso e Score) -->
    <div class="fixed top-0 left-0 right-0 bg-white border-b border-gray-200 z-50 shadow-sm h-16 flex items-center px-4 md:px-8 justify-between">
        <div class="flex items-center gap-3">
            <div class="bg-indigo-600 text-white p-2 rounded-lg">
                <i data-lucide="award" class="w-5 h-5"></i>
            </div>
            <h1 class="font-bold text-lg text-slate-800 hidden md:block">Simulado ANBIMA</h1>
        </div>

        <div class="flex items-center gap-6">
            <div class="text-right">
                <p class="text-xs text-slate-500 uppercase font-semibold">Progresso</p>
                <p class="text-sm font-bold text-indigo-600"><span id="progress-count">0</span> / 90</p>
            </div>
            <div class="text-right">
                <p class="text-xs text-slate-500 uppercase font-semibold">Acertos</p>
                <p class="text-sm font-bold text-green-600" id="score-count">0</p>
            </div>
            <button onclick="resetSimulado()" class="p-2 text-red-500 hover:bg-red-50 rounded-full transition-colors" title="Reiniciar Simulado">
                <i data-lucide="rotate-ccw" class="w-5 h-5"></i>
            </button>
        </div>
    </div>

    <div class="flex pt-16 min-h-screen">
        
        <!-- Sidebar de Navegação (Desktop) -->
        <aside class="hidden lg:block w-72 bg-white border-r border-gray-200 fixed bottom-0 top-16 overflow-y-auto p-6">
            <h3 class="text-xs font-bold text-slate-400 uppercase tracking-wider mb-4">Navegação Rápida</h3>
            <nav class="space-y-1" id="nav-links">
                <!-- Links gerados via JS -->
            </nav>
        </aside>

        <!-- Conteúdo Principal -->
        <main class="flex-1 lg:ml-72 p-4 md:p-8 max-w-4xl mx-auto">
            
            <div class="mb-8 mt-4">
                <h2 class="text-2xl font-bold text-slate-900 mb-2">Simulado Completo</h2>
                <p class="text-slate-600">
                    Responda as 90 questões abaixo. O sistema salva seu progresso automaticamente. 
                    Clique na alternativa para ver a correção e explicação imediata.
                </p>
            </div>

            <!-- Container das Questões -->
            <div id="questions-container" class="space-y-12 pb-20">
                <!-- Questões injetadas via JS -->
            </div>

        </main>
    </div>

    <!-- Script Principal -->
    <script>
        // --- BANCO DE DADOS DAS 90 QUESTÕES ---
        const questionsData = [
            // BLOCO 1 (10 Questões)
            { id: 1, category: "BLOCO 1 — Ética, Conduta e Adequação", text: "O princípio da lealdade no relacionamento com o cliente exige que o profissional:", options: ["Priorize os interesses da instituição", "Atue sempre em benefício do cliente, mesmo quando houver conflito", "Ofereça apenas produtos conservadores", "Execute ordens sem questionamento"], correct: 1, explanation: "O Princípio da Lealdade (Dever Fiduciário) exige colocar os interesses do cliente acima dos da instituição ou do próprio profissional." },
            { id: 2, category: "BLOCO 1", text: "O dever de adequação tem como principal objetivo:", options: ["Reduzir riscos legais da instituição", "Garantir que o produto seja compatível com o perfil e objetivos do cliente", "Aumentar a rentabilidade da carteira", "Padronizar investimentos"], correct: 1, explanation: "Adequação (Suitability) serve para proteger o investidor, garantindo que ele não invista em algo que não entende ou que tenha riscos superiores à sua tolerância." },
            { id: 3, category: "BLOCO 1", text: "É considerada prática vedada ao profissional certificado ANBIMA:", options: ["Atualizar o cadastro do cliente", "Prometer rentabilidade futura", "Informar riscos do produto", "Registrar o atendimento"], correct: 1, explanation: "É estritamente proibido garantir ou prometer rentabilidade futura em produtos de risco (Renda Variável, Fundos), pois o retorno é incerto." },
            { id: 4, category: "BLOCO 1", text: "(CASE) Um cliente classificado como conservador solicita investir em um produto de alto risco, afirmando estar ciente das possíveis perdas. O profissional deve:", options: ["Executar a ordem imediatamente", "Recusar o investimento", "Orientar sobre os riscos, registrar a ciência do cliente e avaliar a adequação", "Alterar o perfil para agressivo"], correct: 2, explanation: "O cliente pode investir fora do perfil (desenquadramento), desde que seja alertado sobre o risco e a inadequação, e dê seu aceite formal (Termo de Desenquadramento)." },
            { id: 5, category: "BLOCO 1", text: "A transparência no atendimento pressupõe:", options: ["Comunicação apenas quando solicitada", "Clareza sobre riscos, custos e características dos produtos", "Linguagem técnica obrigatória", "Foco exclusivo na rentabilidade"], correct: 1, explanation: "A transparência exige que todas as informações relevantes (vantagens, riscos, custos, liquidez) sejam passadas de forma clara e compreensível, sem omissões que induzam a erro." },
            { id: 6, category: "BLOCO 1", text: "O conflito de interesses ocorre quando:", options: ["O cliente assume risco elevado", "O profissional tem interesse próprio que pode afetar sua recomendação", "O mercado apresenta volatilidade", "O produto possui taxa elevada"], correct: 1, explanation: "Quando o ganho do profissional (ex: meta, comissão) compete com o melhor interesse do cliente." },
            { id: 7, category: "BLOCO 1", text: "O registro do atendimento é importante porque:", options: ["Substitui o questionário de perfil", "Documenta as orientações e decisões tomadas", "Serve apenas para auditoria interna", "É facultativo"], correct: 1, explanation: "O registro comprova que o profissional cumpriu seu dever de informação e suitability, servindo de proteção para ambas as partes." },
            { id: 8, category: "BLOCO 1", text: "O profissional deve recusar uma recomendação quando:", options: ["O cliente insiste", "O produto é incompatível com o perfil e objetivos do investidor", "A taxa de administração é alta", "O mercado está favorável"], correct: 1, explanation: "Se o produto não é adequado (suitability), o profissional não deve RECOMENDAR. Se o cliente insistir (ordem não solicitada), aí aplica-se o desenquadramento." },
            { id: 9, category: "BLOCO 1", text: "É dever do profissional certificado:", options: ["Garantir retorno mínimo", "Atuar com diligência e boa-fé", "Prometer segurança absoluta", "Eliminar riscos"], correct: 1, explanation: "Diligência (cuidado, zelo) e Boa-fé são os pilares da conduta ética. Garantir retorno ou eliminar risco é impossível no mercado." },
            { id: 10, category: "BLOCO 1", text: "(CASE) Durante o atendimento, o cliente demonstra não compreender totalmente o funcionamento do produto indicado. O profissional deve:", options: ["Prosseguir para não perder a venda", "Simplificar a explicação e confirmar o entendimento", "Solicitar assinatura imediata", "Encerrar o atendimento"], correct: 1, explanation: "O dever de informação exige que o cliente COMPREENDA. O profissional deve ajustar a linguagem até ter certeza que o cliente entendeu o que está contratando." },

            // BLOCO 2 (8 Questões)
            { id: 11, category: "BLOCO 2 — Sistema Financeiro Nacional", text: "O Conselho Monetário Nacional (CMN) tem como função principal:", options: ["Executar a política monetária", "Definir diretrizes do Sistema Financeiro Nacional", "Fiscalizar instituições financeiras", "Regular fundos de investimento"], correct: 1, explanation: "O CMN é o órgão normativo máximo. Ele 'manda', define as metas (ex: Meta de Inflação) e diretrizes gerais. Quem executa é o Banco Central." },
            { id: 12, category: "BLOCO 2", text: "O Banco Central do Brasil é responsável por:", options: ["Regular o mercado de capitais", "Executar a política monetária e controlar a liquidez", "Garantir depósitos dos investidores", "Administrar fundos"], correct: 1, explanation: "O Bacen executa as ordens do CMN, controla a inflação (via Selic/Compulsório) e fiscaliza os bancos." },
            { id: 13, category: "BLOCO 2", text: "A Comissão de Valores Mobiliários (CVM) atua principalmente na:", options: ["Política fiscal", "Supervisão do mercado de valores mobiliários", "Definição da taxa Selic", "Garantia de crédito"], correct: 1, explanation: "A CVM cuida do mercado de capitais: Bolsa, Fundos, Ações e Debêntures. Protege o investidor nessas áreas." },
            { id: 14, category: "BLOCO 2", text: "A ANBIMA é caracterizada como entidade de:", options: ["Fiscalização governamental", "Autorregulação do mercado financeiro", "Política monetária", "Supervisão bancária"], correct: 1, explanation: "ANBIMA é uma associação privada que exerce a Autorregulação (regras criadas pelo próprio mercado para elevar o padrão de qualidade)." },
            { id: 15, category: "BLOCO 2", text: "A taxa Selic é utilizada como referência para:", options: ["Rentabilidade de ações", "Juros básicos da economia", "Taxas de câmbio", "Índices imobiliários"], correct: 1, explanation: "A Selic é a taxa livre de risco e balizadora de todo o crédito e rentabilidade da Renda Fixa no país." },
            { id: 16, category: "BLOCO 2", text: "O Fundo Garantidor de Créditos (FGC) tem como objetivo:", options: ["Proteger investidores contra perdas de mercado", "Garantir depósitos em caso de insolvência da instituição", "Cobrir prejuízos em ações", "Garantir rentabilidade mínima"], correct: 1, explanation: "O FGC garante que você receba seu dinheiro de volta (até o limite) se o banco quebrar (insolvência). Não cobre oscilação de mercado." },
            { id: 17, category: "BLOCO 2", text: "Estão cobertos pelo FGC:", options: ["Ações", "Fundos de investimento", "CDB e LCI", "Debêntures"], correct: 2, explanation: "FGC cobre produtos bancários: Conta Corrente, Poupança, CDB, LCI, LCA, LC. Fundos e Ações não têm essa garantia." },
            { id: 18, category: "BLOCO 2", text: "O limite de cobertura do FGC é de:", options: ["R$ 100 mil por CPF", "R$ 250 mil por CPF e instituição", "R$ 500 mil por aplicação", "Valor ilimitado"], correct: 1, explanation: "A regra atual é R$ 250 mil por CPF e por Conglomerado Financeiro (limitado a um teto global de R$ 1 milhão a cada 4 anos)." },

            // BLOCO 3 (8 Questões)
            { id: 19, category: "BLOCO 3 — Perfil do Investidor, Risco e Liquidez", text: "Um investidor conservador prioriza principalmente:", options: ["Alta rentabilidade", "Segurança e liquidez", "Exposição a ações", "Volatilidade"], correct: 1, explanation: "O conservador não quer perder o principal. Ele aceita ganhar menos em troca de Segurança (não perder) e Liquidez (sacar rápido)." },
            { id: 20, category: "BLOCO 3", text: "O perfil do investidor deve ser revisto quando:", options: ["O mercado oscila", "Há mudança na situação financeira ou objetivos", "O profissional decide", "O cliente obtém ganhos"], correct: 1, explanation: "O perfil muda com a vida. Casamento, herança, aposentadoria, desemprego alteram a capacidade e vontade de tomar risco." },
            { id: 21, category: "BLOCO 3", text: "Liquidez pode ser definida como:", options: ["Nível de risco do investimento", "Facilidade de conversão em dinheiro", "Rentabilidade esperada", "Prazo de vencimento"], correct: 1, explanation: "Liquidez é a velocidade e facilidade com que você transforma um ativo em dinheiro na conta pelo preço justo." },
            { id: 22, category: "BLOCO 3", text: "Rentabilidade passada:", options: ["Garante desempenho futuro", "Serve apenas como referência histórica", "Elimina riscos", "Substitui análise"], correct: 1, explanation: "Regra de ouro: Rentabilidade passada não é garantia de rentabilidade futura. O mercado muda." },
            { id: 23, category: "BLOCO 3", text: "A diversificação reduz principalmente:", options: ["Risco sistemático", "Risco específico", "Inflação", "Tributação"], correct: 1, explanation: "Diversificar (comprar vários ativos) elimina o risco de UM ativo específico dar problema. Não elimina o risco do mercado todo (sistemático) cair." },
            { id: 24, category: "BLOCO 3", text: "(CASE) Cliente pretende utilizar os recursos em 3 meses. Qual característica é essencial no investimento?", options: ["Alta volatilidade", "Baixa liquidez", "Alta liquidez", "Longo prazo"], correct: 2, explanation: "Para prazos curtos, a liquidez é o fator mais importante. O cliente precisa ter certeza que poderá resgatar o dinheiro em 3 meses sem travas." },
            { id: 25, category: "BLOCO 3", text: "O risco de crédito está associado à:", options: ["Variação do preço do ativo", "Possibilidade de inadimplência do emissor", "Oscilação do mercado", "Inflação"], correct: 1, explanation: "Risco de crédito é o 'risco de calote'. É o emissor não devolver o dinheiro emprestado." },
            { id: 26, category: "BLOCO 3", text: "Um investimento com maior risco tende a oferecer:", options: ["Menor retorno", "Maior retorno esperado", "Retorno garantido", "Ausência de volatilidade"], correct: 1, explanation: "Relação Risco x Retorno: ninguém corre risco de graça. Para aceitar risco, o investidor exige uma expectativa de retorno maior." },

            // BLOCO 4 (12 Questões)
            { id: 27, category: "BLOCO 4 — Renda Fixa", text: "Um título de renda fixa caracteriza-se por:", options: ["Rentabilidade imprevisível", "Regras de remuneração definidas", "Ausência de risco", "Liquidez obrigatória"], correct: 1, explanation: "Na Renda Fixa, você sabe COMO será pago (ex: 10% ou 100% do CDI) no momento da contratação." },
            { id: 28, category: "BLOCO 4", text: "O emissor de um CDB é:", options: ["Tesouro Nacional", "Instituição financeira", "Empresa não financeira", "Bolsa de valores"], correct: 1, explanation: "CDB (Certificado de Depósito Bancário) é emitido por Bancos (Instituições Financeiras)." },
            { id: 29, category: "BLOCO 4", text: "O Tesouro Selic é mais indicado para:", options: ["Investimentos de longo prazo com volatilidade", "Reserva de emergência", "Especulação", "Proteção cambial"], correct: 1, explanation: "Por ter baixa volatilidade e liquidez diária, é o ativo mais seguro para Reserva de Emergência." },
            { id: 30, category: "BLOCO 4", text: "Um título prefixado apresenta:", options: ["Rentabilidade atrelada à inflação", "Taxa definida no momento da aplicação", "Rentabilidade variável", "Isenção de risco"], correct: 1, explanation: "No prefixado, a taxa é nominal e fixa (ex: 12% a.a.). Você sabe o valor final exato em reais se levar ao vencimento." },
            { id: 31, category: "BLOCO 4", text: "O risco de mercado em títulos de renda fixa está relacionado à:", options: ["Inadimplência", "Oscilação das taxas de juros", "Falta de liquidez", "Tributação"], correct: 1, explanation: "Se os juros de mercado sobem, o preço do título prefixado cai (Marcação a Mercado). Isso é risco de mercado na renda fixa." },
            { id: 32, category: "BLOCO 4", text: "Marcação a mercado significa:", options: ["Manter o título até o vencimento", "Atualizar diariamente o valor do título conforme o mercado", "Garantir retorno", "Eliminar volatilidade"], correct: 1, explanation: "É trazer o valor do título para o preço justo de hoje. Se vender hoje, é esse valor que recebe (pode ter ágio ou deságio)." },
            { id: 33, category: "BLOCO 4", text: "LCI e LCA possuem como principal vantagem para pessoa física:", options: ["Alta liquidez", "Isenção de Imposto de Renda", "Rentabilidade garantida", "Prazo curto"], correct: 1, explanation: "LCI (Imobiliário) e LCA (Agro) são isentos de IR para PF como forma de incentivo do governo a esses setores." },
            { id: 34, category: "BLOCO 4", text: "Quanto maior o prazo do investimento em renda fixa tributável, segundo a tabela regressiva:", options: ["Maior o imposto", "Menor o imposto", "Imposto fixo", "Isenção automática"], correct: 1, explanation: "A tabela regressiva beneficia quem deixa o dinheiro mais tempo. Começa em 22,5% e cai para 15% após 720 dias." },
            { id: 35, category: "BLOCO 4", text: "(CASE) Cliente deseja previsibilidade de retorno até o vencimento. Qual produto é mais adequado?", options: ["Tesouro Selic", "Tesouro Prefixado", "Fundo multimercado", "Fundo de ações"], correct: 1, explanation: "O Tesouro Prefixado é o único que diz exatamente quanto vai render (ex: 10% a.a.) se carregado até o final, garantindo previsibilidade nominal." },
            { id: 36, category: "BLOCO 4", text: "A tabela regressiva do IR na renda fixa inicia em:", options: ["15%", "17,5%", "20%", "22,5%"], correct: 3, explanation: "A alíquota máxima para curto prazo (até 180 dias) é de 22,5%." },
            { id: 37, category: "BLOCO 4", text: "O FGC cobre aplicações até o limite de:", options: ["R$ 100 mil", "R$ 250 mil", "R$ 500 mil", "Sem limite"], correct: 1, explanation: "R$ 250.000,00 por CPF e por instituição financeira." },
            { id: 38, category: "BLOCO 4", text: "Um investimento resgatado antes do vencimento pode sofrer:", options: ["Isenção de imposto", "Oscilação de preço", "Garantia de retorno", "Eliminação de risco"], correct: 1, explanation: "Devido à Marcação a Mercado, sair antes do prazo expõe o investidor à oscilação de preço, podendo gerar prejuízo sobre o principal." },

            // BLOCO 5 (7 Questões)
            { id: 39, category: "BLOCO 5 — Fundos de Investimento", text: "Um fundo de investimento é juridicamente um:", options: ["Título de crédito", "Condomínio de investidores", "Derivativo", "Banco"], correct: 1, explanation: "Fundo é um condomínio onde diversos investidores (cotistas) juntam recursos para investir em conjunto sob regras comuns." },
            { id: 40, category: "BLOCO 5", text: "A taxa de administração de um fundo é cobrada:", options: ["Apenas se houver lucro", "Independentemente da rentabilidade", "Somente no resgate", "Apenas em fundos de ações"], correct: 1, explanation: "A taxa de administração paga os custos fixos (gestor, administrador) e é cobrada sempre, mesmo que o fundo tenha prejuízo." },
            { id: 41, category: "BLOCO 5", text: "Fundos DI investem majoritariamente em:", options: ["Ações", "Títulos atrelados à taxa Selic", "Moedas estrangeiras", "Imóveis"], correct: 1, explanation: "Fundos DI (Referenciados DI) investem em títulos de baixo risco (públicos ou privados) atrelados à Selic/CDI." },
            { id: 42, category: "BLOCO 5", text: "O patrimônio líquido de um fundo corresponde:", options: ["Ao capital do gestor", "Aos ativos menos os passivos", "Apenas ao lucro", "À rentabilidade acumulada"], correct: 1, explanation: "PL = Soma de tudo que o fundo tem (Ativos) menos o que ele deve pagar (Passivos/Despesas)." },
            { id: 43, category: "BLOCO 5", text: "O come-cotas ocorre em fundos de:", options: ["Ações", "Renda fixa e multimercado", "Imobiliários", "ETFs"], correct: 1, explanation: "Come-cotas (antecipação de IR) ocorre em maio e novembro nos fundos de Renda Fixa, Cambial e Multimercado (Abertos)." },
            { id: 44, category: "BLOCO 5", text: "(CASE) Cliente conservador deseja investir via fundo com liquidez diária. Qual fundo é mais adequado?", options: ["Fundo de ações", "Fundo cambial", "Fundo DI", "Fundo multimercado agressivo"], correct: 2, explanation: "O Fundo DI oferece baixo risco e liquidez imediata, alinhado ao perfil conservador." },
            { id: 45, category: "BLOCO 5", text: "Fundos de investimento são regulados pela:", options: ["ANBIMA", "CVM", "Receita Federal", "Banco Central"], correct: 1, explanation: "A Comissão de Valores Mobiliários (CVM) é o órgão regulador e fiscalizador da indústria de fundos no Brasil." },

            // BLOCO 6 (5 Questões)
            { id: 46, category: "BLOCO 6 — Tributação Básica e Situações Práticas", text: "O imposto sobre renda fixa incide sobre:", options: ["Valor total investido", "Apenas o rendimento", "O patrimônio", "O prazo"], correct: 1, explanation: "O IR incide apenas sobre o LUCRO (rendimento). O valor principal investido não é tributado novamente." },
            { id: 47, category: "BLOCO 6", text: "Ganho de capital ocorre quando:", options: ["O investimento vence", "O valor de venda é maior que o de compra", "Há pagamento de juros", "O fundo cobra taxa"], correct: 1, explanation: "Ganho de capital é a diferença positiva entre o preço que você vendeu e o preço que pagou." },
            { id: 48, category: "BLOCO 6", text: "(CASE) Cliente resgata um CDB após 150 dias. Qual a alíquota de IR?", options: ["15%", "17,5%", "20%", "22,5%"], correct: 3, explanation: "Até 180 dias, a alíquota é a máxima da tabela regressiva: 22,5%." },
            { id: 49, category: "BLOCO 6", text: "Dividendos recebidos por pessoa física são, atualmente:", options: ["Tributados na fonte", "Isentos de IR", "Tributados na declaração", "Considerados ganho de capital"], correct: 1, explanation: "Pela legislação atual, dividendos distribuídos por ações são isentos de IR para pessoa física." },
            { id: 50, category: "BLOCO 6", text: "(CASE) Cliente deseja alto retorno em curto prazo, com baixo risco. A conduta correta do profissional é:", options: ["Prometer rentabilidade", "Explicar que risco e retorno estão relacionados", "Oferecer ações", "Executar a ordem sem esclarecimentos"], correct: 1, explanation: "Não existe 'alto retorno, curto prazo e baixo risco' (tríade impossível). O profissional deve educar o cliente sobre a relação risco x retorno." },

            // BLOCO 7 - Prática Avançada (40 Questões Extras)
            { id: 51, category: "BLOCO 7 — Prática Avançada", text: "O PIB mede:", options: ["A inflação", "A soma de bens e serviços finais produzidos", "O déficit público", "O câmbio"], correct: 1, explanation: "PIB é a soma de riquezas, o termômetro da atividade econômica." },
            { id: 52, category: "BLOCO 7", text: "Política Fiscal Contracionista envolve:", options: ["Aumento de gastos", "Aumento de impostos e corte de gastos", "Queda de juros", "Emissão de moeda"], correct: 1, explanation: "Visa reduzir a demanda agregada e controlar a inflação/dívida." },
            { id: 53, category: "BLOCO 7", text: "Chinese Wall serve para evitar:", options: ["Lavagem de dinheiro", "Conflito de interesses e Insider Trading", "Risco de mercado", "Tributação"], correct: 1, explanation: "Barreira que segrega informações entre áreas conflitantes do banco." },
            { id: 54, category: "BLOCO 7", text: "PGBL é ideal para quem:", options: ["Faz declaração simplificada", "É isento", "Faz declaração completa", "Quer liquidez diária"], correct: 2, explanation: "Permite dedução fiscal de até 12% da renda bruta." },
            { id: 55, category: "BLOCO 7", text: "VGBL tributa:", options: ["Total", "Lucro", "Nada", "Entrada"], correct: 1, explanation: "IR incide apenas sobre os rendimentos (lucro), não sobre o principal." },
            { id: 56, category: "BLOCO 7", text: "Smurfing é técnica de:", options: ["Investimento", "Lavagem de dinheiro (fracionamento)", "Hedge", "Análise"], correct: 1, explanation: "Fracionar grandes depósitos em pequenos para evitar alertas." },
            { id: 57, category: "BLOCO 7", text: "COAF deve ser comunicado:", options: ["Com aviso ao cliente", "Sem aviso ao cliente", "Apenas com ordem judicial", "Mensalmente"], correct: 1, explanation: "Sigilo absoluto é obrigatório (Tipping Off é proibido)." },
