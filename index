        // --- LÓGICA DO SIMULADO ---
        let currentState = {
            currentIndex: 0,
            score: 0,
            answers: {},
            order: [],
            isShuffled: false
        };

        let currentOptionsOrder = [];
        let hasAnsweredCurrent = false;

        const screens = {
            home: document.getElementById('screen-home'),
            quiz: document.getElementById('screen-quiz'),
            result: document.getElementById('screen-result'),
            pause: document.getElementById('screen-pause')
        };
        const headerActions = document.getElementById('header-actions');

        function hideAllScreens() {
            Object.values(screens).forEach(s => s.classList.add('hidden-screen'));
        }

        function showScreen(screenName) {
            hideAllScreens();
            screens[screenName].classList.remove('hidden-screen');
            if(screenName === 'quiz') {
                headerActions.classList.remove('hidden');
            } else {
                headerActions.classList.add('hidden');
            }
        }

        function shuffleArray(array) {
            const arr = [...array];
            for (let i = arr.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [arr[i], arr[j]] = [arr[j], arr[i]];
            }
            return arr;
        }

        function init() {
            const savedState = localStorage.getItem('simulado_cpa_state_full');
            if (savedState) {
                try {
                    const parsed = JSON.parse(savedState);
                    if (parsed && parsed.order && parsed.order.length > 0 && parsed.currentIndex < parsed.order.length) {
                        currentState = parsed;
                        document.getElementById('btn-continue').classList.remove('hidden');
                    }
                } catch (e) {
                    localStorage.removeItem('simulado_cpa_state_full');
                }
            }
        }

        function saveState() {
            localStorage.setItem('simulado_cpa_state_full', JSON.stringify(currentState));
        }

        function clearState() {
            localStorage.removeItem('simulado_cpa_state_full');
            currentState = {
                currentIndex: 0,
                score: 0,
                answers: {},
                order: [],
                isShuffled: false
            };
        }

        function goHome() {
            if (currentState.order && currentState.order.length > 0 && currentState.currentIndex < currentState.order.length) {
                saveState(); // Ensure progress is saved
                document.getElementById('btn-continue').classList.remove('hidden');
            }
            showScreen('home');
        }

        function startQuiz(shuffle = false) {
            clearState();
            currentState.isShuffled = shuffle;
            
            let baseOrder = Array.from({length: db.length}, (_, i) => i);
            if (shuffle) {
                currentState.order = shuffleArray(baseOrder);
            } else {
                currentState.order = baseOrder;
            }
            
            saveState();
            renderQuestion();
            showScreen('quiz');
        }

        function resumeQuiz() {
            if (currentState.currentIndex >= currentState.order.length) {
                showResults();
            } else {
                renderQuestion();
                showScreen('quiz');
            }
        }

        function pauseQuiz() {
            saveState();
            showScreen('pause');
        }

        function resetQuiz() {
            clearState();
            document.getElementById('btn-continue').classList.add('hidden');
            showScreen('home');
        }

        function renderQuestion() {
            hasAnsweredCurrent = false;
            document.getElementById('btn-next').classList.add('hidden');
            document.getElementById('feedback-container').classList.add('hidden');
            
            const qIndex = currentState.order[currentState.currentIndex];
            const qData = db[qIndex];
            
            document.getElementById('question-counter').innerText = `Questão ${currentState.currentIndex + 1} de ${currentState.order.length}`;
            
            const diffSpan = document.getElementById('question-difficulty');
            diffSpan.innerText = qData.d || 'Média';
            diffSpan.className = 'px-3 py-1 rounded-full text-sm font-semibold border';
            if(qData.d === 'Fácil') diffSpan.classList.add('bg-green-100', 'text-green-800', 'border-green-300');
            else if(qData.d === 'Difícil') diffSpan.classList.add('bg-red-100', 'text-red-800', 'border-red-300');
            else diffSpan.classList.add('bg-yellow-100', 'text-yellow-800', 'border-yellow-300');

            const ctxEl = document.getElementById('question-context');
            if (qData.c) {
                ctxEl.innerText = qData.c;
                ctxEl.classList.remove('hidden');
            } else {
                ctxEl.classList.add('hidden');
            }

            document.getElementById('question-text').innerText = qData.q;

            const optsContainer = document.getElementById('options-container');
            optsContainer.innerHTML = '';
            
            let optIndices = [0, 1, 2, 3];
            if (currentState.isShuffled) {
                optIndices = shuffleArray(optIndices);
            }
            currentOptionsOrder = optIndices;

            const labels = ['A', 'B', 'C', 'D'];

            optIndices.forEach((originalIndex, index) => {
                const optData = qData.o[originalIndex];
                
                const btn = document.createElement('button');
                btn.className = 'option-btn w-full text-left p-4 rounded-xl border-2 border-slate-200 bg-white hover:border-blue-400 hover:bg-blue-50 focus:outline-none flex gap-4 items-start shadow-sm transition';
                btn.onclick = () => selectOption(originalIndex, index);
                btn.id = `opt-btn-${index}`;
                
                btn.innerHTML = `
                    <div class="flex-shrink-0 w-8 h-8 rounded-full bg-slate-100 text-slate-600 font-bold flex items-center justify-center border border-slate-300" id="opt-label-${index}">
                        ${labels[index]}
                    </div>
                    <div class="text-slate-700 font-medium leading-relaxed mt-1">
                        ${optData.t}
                    </div>
                `;
                optsContainer.appendChild(btn);
            });

            if (currentState.answers[currentState.currentIndex]) {
                const savedAns = currentState.answers[currentState.currentIndex];
                const uiIndex = currentOptionsOrder.indexOf(savedAns.selectedOptionIndex);
                selectOption(savedAns.selectedOptionIndex, uiIndex, true);
            }
        }

        function selectOption(originalIndex, uiIndex, isRestoring = false) {
            if (hasAnsweredCurrent && !isRestoring) return;
            hasAnsweredCurrent = true;

            const qIndex = currentState.order[currentState.currentIndex];
            const qData = db[qIndex];
            const isCorrect = qData.o[originalIndex].v;

            if (!isRestoring) {
                currentState.answers[currentState.currentIndex] = {
                    selectedOptionIndex: originalIndex,
                    isCorrect: isCorrect
                };
                if (isCorrect) currentState.score++;
                saveState();
            }

            currentOptionsOrder.forEach((origIdx, uIdx) => {
                const btn = document.getElementById(`opt-btn-${uIdx}`);
                const label = document.getElementById(`opt-label-${uIdx}`);
                btn.disabled = true;
                btn.classList.remove('hover:border-blue-400', 'hover:bg-blue-50', 'border-slate-200', 'shadow-sm');
                
                const optData = qData.o[origIdx];

                if (optData.v) {
                    btn.classList.add('border-green-500', 'bg-green-50', 'shadow-md');
                    label.classList.add('bg-green-600', 'text-white', 'border-green-700');
                    label.classList.remove('bg-slate-100', 'text-slate-600');
                } else if (uIdx === uiIndex && !isCorrect) {
                    btn.classList.add('border-red-500', 'bg-red-50', 'shadow-md');
                    label.classList.add('bg-red-600', 'text-white', 'border-red-700');
                    label.classList.remove('bg-slate-100', 'text-slate-600');
                } else {
                    btn.classList.add('opacity-40');
                }
            });

            const feedbackContainer = document.getElementById('feedback-container');
            const fbTitle = document.getElementById('feedback-title');
            const fbText = document.getElementById('feedback-text');

            feedbackContainer.classList.remove('hidden', 'bg-green-100', 'border-green-500', 'text-green-800', 'bg-red-100', 'border-red-500', 'text-red-800');
            
            if (isCorrect) {
                feedbackContainer.classList.add('bg-green-100', 'border-green-500', 'text-green-900');
                fbTitle.innerHTML = '<i class="fas fa-check-circle"></i> Resposta Correta!';
            } else {
                feedbackContainer.classList.add('bg-red-100', 'border-red-500', 'text-red-900');
                fbTitle.innerHTML = '<i class="fas fa-times-circle"></i> Resposta Incorreta!';
            }

            let explanation = `<strong>Por que?</strong> ${qData.o[originalIndex].e}`;
            if (!isCorrect) {
                const correctOpt = qData.o.find(o => o.v);
                explanation += `<br><br><strong><i class="fas fa-lightbulb text-yellow-500"></i> Gabarito (Letra ${['A','B','C','D'][currentOptionsOrder.findIndex(i => i === qData.o.indexOf(correctOpt))]}):</strong> ${correctOpt.e}`;
            }
            fbText.innerHTML = explanation;

            const btnNext = document.getElementById('btn-next');
            if (currentState.currentIndex === currentState.order.length - 1) {
                btnNext.innerHTML = 'Ver Resultado Final <i class="fas fa-flag-checkered ml-2"></i>';
            } else {
                btnNext.innerHTML = 'Próxima Questão <i class="fas fa-arrow-right ml-2"></i>';
            }
            btnNext.classList.remove('hidden');
        }

        function nextQuestion() {
            if (currentState.currentIndex < currentState.order.length - 1) {
                currentState.currentIndex++;
                saveState();
                renderQuestion();
                window.scrollTo(0,0);
            } else {
                showResults();
            }
        }

        function showResults() {
            clearState(); 
            document.getElementById('btn-continue').classList.add('hidden');
            
            document.getElementById('score-correct').innerText = currentState.score;
            document.getElementById('score-total').innerText = currentState.order.length;
            
            const percent = (currentState.score / currentState.order.length) * 100;
            
            showScreen('result');
            
            setTimeout(() => {
                const bar = document.getElementById('score-bar');
                bar.style.width = `${percent}%`;
                if(percent >= 70) {
                    bar.className = 'bg-green-500 h-4 rounded-full transition-all duration-1000';
                } else if(percent >= 50) {
                    bar.className = 'bg-yellow-500 h-4 rounded-full transition-all duration-1000';
                } else {
                    bar.className = 'bg-red-500 h-4 rounded-full transition-all duration-1000';
                }
            }, 100);
        }

        window.onload = init;
    </script>
