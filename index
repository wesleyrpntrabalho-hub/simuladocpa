            { id: 90, category: "BLOCO 7", text: "Previdência Regressiva 2 anos:", options: ["10%", "15%", "35%", "25%"], correct: 2, explanation: "Começa com alíquota punitiva de 35%." }
        ];

        // --- APP LOGIC (Safe Initialization) ---
        document.addEventListener('DOMContentLoaded', () => {
            // Load saved answers
            let userAnswers = JSON.parse(localStorage.getItem('simulado90Progress')) || {};

            // Render Nav Links
            const nav = document.getElementById('nav-links');
            const mobileMenu = document.getElementById('mobile-menu-items');
            
            if (nav && mobileMenu) {
                let categories = [...new Set(questionsData.map(q => q.category))];
                
                const links = categories.map((cat, index) => `
                    <a href="#cat-${index}" class="block py-2 px-3 text-sm text-slate-600 hover:bg-indigo-50 hover:text-indigo-600 rounded transition-colors text-left">
                        ${cat}
                    </a>
                `).join('');
                
                nav.innerHTML = links;
                mobileMenu.innerHTML = links;
            }

            // Render Questions
            renderQuestions(userAnswers);
            updateScore(userAnswers);
        });

        function renderQuestions(userAnswers) {
            const container = document.getElementById('questions-container');
            if (!container) return;

            let currentCategory = "";
            let html = "";
            let catIndex = -1;

            questionsData.forEach((q) => {
                // Category Header
                if (q.category !== currentCategory) {
                    currentCategory = q.category;
                    catIndex++;
                    html += `
                        <div id="cat-${catIndex}" class="mt-12 mb-6 border-b-2 border-indigo-100 pb-2 scroll-mt-24">
                            <h3 class="text-xl font-bold text-indigo-800 flex items-center gap-2">
                                <i data-lucide="layers" class="w-5 h-5"></i> ${currentCategory}
                            </h3>
                        </div>
                    `;
                }

                const userAnswer = userAnswers[q.id];
                const isAnswered = userAnswer !== undefined;
                const isCorrect = isAnswered && userAnswer === q.correct;
                
                let feedbackHtml = '';
                let borderClass = 'border-slate-200 hover:border-indigo-200';
                let bgClass = 'bg-white';

                if (isAnswered) {
                    if (isCorrect) {
                        borderClass = 'border-green-400';
                        bgClass = 'bg-green-50/40';
                        feedbackHtml = `
                            <div class="mt-4 p-4 bg-green-100 rounded-lg border border-green-200 text-sm fade-in-up">
                                <div class="font-bold text-green-700 flex items-center gap-2 mb-1">
                                    <i data-lucide="check-circle" class="w-4 h-4"></i> Resposta Correta!
                                </div>
                                <div class="text-green-800 leading-relaxed">${q.explanation}</div>
                            </div>`;
                    } else {
                        borderClass = 'border-red-400';
                        bgClass = 'bg-red-50/40';
                        feedbackHtml = `
                            <div class="mt-4 p-4 bg-red-100 rounded-lg border border-red-200 text-sm fade-in-up">
                                <div class="font-bold text-red-700 flex items-center gap-2 mb-1">
                                    <i data-lucide="x-circle" class="w-4 h-4"></i> Incorreto.
                                </div>
                                <div class="text-red-800 mb-2">A resposta correta é: <strong>${['A','B','C','D'][q.correct]}</strong></div>
                                <div class="text-slate-700 bg-white/50 p-2 rounded border border-red-200 leading-relaxed"><strong>Explicação:</strong> ${q.explanation}</div>
                            </div>
                        `;
                    }
                }

                html += `
                    <div class="p-6 rounded-xl border-2 shadow-sm ${borderClass} ${bgClass} transition-all duration-300 relative group">
                        <div class="flex items-start gap-3 mb-4">
                            <span class="bg-indigo-600 text-white font-bold w-8 h-8 flex items-center justify-center rounded-full flex-shrink-0 text-sm shadow-sm">${q.id}</span>
                            <h3 class="text-lg font-medium text-slate-800 leading-snug">${q.text}</h3>
                        </div>
                        
                        <div class="space-y-2 ml-0 md:ml-11">
                            ${q.options.map((opt, optIdx) => {
                                const isSelected = userAnswer === optIdx;
                                
                                let optionClass = "p-3 rounded-lg border border-slate-200 hover:bg-slate-50 cursor-pointer flex items-center gap-3 transition-colors select-none";
                                
                                if (isAnswered) {
                                    const isThisCorrect = q.correct === optIdx;
                                    if (isSelected && isCorrect) optionClass = "p-3 rounded-lg border-2 border-green-500 bg-green-100 font-medium flex items-center gap-3 shadow-sm";
                                    else if (isSelected && !isCorrect) optionClass = "p-3 rounded-lg border-2 border-red-500 bg-red-100 flex items-center gap-3 shadow-sm";
                                    else if (!isSelected && isThisCorrect && !isCorrect) optionClass = "p-3 rounded-lg border border-green-500 bg-green-50 flex items-center gap-3 opacity-70"; 
                                    else optionClass = "p-3 rounded-lg border border-slate-100 opacity-40 flex items-center gap-3 pointer-events-none grayscale";
                                }

                                return `
                                    <div class="${optionClass}" onclick="handleAnswer(${q.id}, ${optIdx})">
                                        <div class="w-6 h-6 rounded-full border-2 border-slate-300 flex items-center justify-center flex-shrink-0 transition-colors ${isSelected ? (isCorrect ? 'border-green-600 bg-green-600' : 'border-red-600 bg-red-600') : ''}">
                                            <span class="text-xs font-bold ${isSelected ? 'text-white' : 'text-slate-400'}">${['A','B','C','D'][optIdx]}</span>
                                        </div>
                                        <span class="text-sm text-slate-700 flex-1">${opt}</span>
                                    </div>
                                `;
                            }).join('')}
                        </div>
                        <div class="ml-0 md:ml-11">
                            ${feedbackHtml}
                        </div>
                    </div>
                `;
            });

            container.innerHTML = html;
            lucide.createIcons();
        }

        function handleAnswer(qId, optIdx) {
            let userAnswers = JSON.parse(localStorage.getItem('simulado90Progress')) || {};
            if (userAnswers[qId] !== undefined) return; // Locked if answered
            
            userAnswers[qId] = optIdx;
            localStorage.setItem('simulado90Progress', JSON.stringify(userAnswers));
            
            renderQuestions(userAnswers);
            updateScore(userAnswers);
        }

        function updateScore(userAnswers) {
            const answered = Object.keys(userAnswers).length;
            const correct = Object.keys(userAnswers).filter(id => {
                const q = questionsData.find(q => q.id == id);
                return q && userAnswers[id] === q.correct;
            }).length;

            const progressEl = document.getElementById('progress-count');
            const scoreEl = document.getElementById('score-count');
            
            if(progressEl) progressEl.innerText = answered;
            if(scoreEl) scoreEl.innerText = correct;
        }

        function resetSimulado() {
            if(confirm("Deseja apagar todo o progresso e começar do zero?")) {
                localStorage.removeItem('simulado90Progress');
                renderQuestions({});
                updateScore({});
            }
        }

        function toggleMobileMenu() {
            const menu = document.getElementById('mobile-menu');
            if(menu) menu.classList.toggle('hidden');
        }

    </script>
